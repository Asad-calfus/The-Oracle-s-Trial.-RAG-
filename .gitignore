# Secrets
.env

# Virtual environment
.venv/

# Python
__pycache__/
*.pyc

# Vector database — regenerated at runtime from uploaded PDFs
data/chroma/

# Application logs
data/logs/

# Generated knowledge-graph visualizations — regenerated on demand, cached
# per document rather than checked in
data/graphs/

# Uploaded documents — may contain personal data, not meant for source control
data/documents/*
!data/documents/.gitkeep

# macOS
.DS_Store

# Local experiment output — may contain PII from test documents
compare_rerank_results.json

# Generated graph visualization output from experiments/ scripts — large,
# regenerable, not source
experiments/graph_visualization.html
